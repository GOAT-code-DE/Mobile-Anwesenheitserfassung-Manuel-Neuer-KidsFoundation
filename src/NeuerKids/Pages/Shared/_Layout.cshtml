@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject IConfiguration Config
@{ var signedIn = User.Identity?.IsAuthenticated == true; var demo = Config.GetValue<bool>("Demo:Enabled"); }
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <title>@ViewData["Title"] · NEUER KIDS</title>
    <link rel="icon" href="data:image/png;base64," type="image/png" />
    <link rel="stylesheet" href="/css/brand-fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/foundation.css" asp-append-version="true" />
    <script src="/js/app.js" asp-append-version="true" defer></script>
</head>
<body class="@(signedIn ? "app-shell" : "auth-shell")" data-page="@ViewData["Page"]">
<a href="#main" class="skip-link">Zum Inhalt</a>
@if (signedIn)
{
    <aside class="sidebar">
        <a class="brand" href="/" aria-label="Manuel Neuer Kids Foundation · Heute"><img src="/brand/foundation-logo.svg" alt="Manuel Neuer Kids Foundation" width="632" height="150" /></a>
        <div class="app-name">ANWESENHEIT</div>
        <div class="sidebar-label">UNSER ALLTAG</div>
        <nav aria-label="Hauptnavigation">
            <a href="/" data-nav="today"><span class="nav-icon">◷</span><span>Heute</span></a>
            <a href="/Children" data-nav="children"><span class="nav-icon">♧</span><span>Kinder</span></a>
            <a href="/Dashboard" data-nav="dashboard"><span class="nav-icon">▥</span><span>Dashboard</span></a>
            <a href="/Admin" data-nav="admin" id="admin-nav" hidden><span class="nav-icon">⚙</span><span>Verwaltung</span></a>
        </nav>
        <div class="sidebar-foot"><span class="small-label">GEMEINSAM FÜR KINDER.</span><p>Zwei Häuser.<br />Ein guter Ort zum Wachsen.</p></div>
    </aside>
    <div class="workspace">
        <div class="mobile-brand"><a href="/" aria-label="Manuel Neuer Kids Foundation · Heute"><img src="/brand/foundation-logo.svg" alt="Manuel Neuer Kids Foundation" width="632" height="150" /></a><span>ANWESENHEIT</span></div>
        <header class="topbar"><div class="location-control"><span class="location-icon">⌖</span><label class="sr-only" for="site-picker">Aktueller Standort</label><select id="site-picker" aria-label="Aktueller Standort"></select></div><div class="account"><span class="user-avatar">NK</span><span id="user-name">Mein Zugang</span><form method="post" asp-page="/Account" asp-page-handler="Logout"><button class="icon-button" title="Abmelden" aria-label="Abmelden">↪</button></form></div></header>
        @if (demo) { <div class="demo-banner"><span>TESTUMGEBUNG</span> Ausschließlich erfundene Beispieldaten · keine echten Kinderdaten eingeben.</div> }
        <main id="main" class="main-content">@RenderBody()</main>
        <footer class="app-footer"><span>Manuel Neuer Kids Foundation</span><span>Gelsenkirchen & Bottrop</span></footer>
    </div>
}
else
{
    <main id="main">@RenderBody()</main>
}
<div id="toast" class="toast" role="status" aria-live="polite" hidden></div>
<noscript><div class="notice">Bitte JavaScript aktivieren, um die Erfassung und das Dashboard zu nutzen.</div></noscript>
</body>
</html>
