<dialog id="child-dialog" class="dialog"><form id="child-form"><div class="dialog-heading"><div><span class="eyebrow">KINDERPROFIL</span><h2 id="child-dialog-title">Kind anlegen</h2></div><button type="button" class="icon-button" data-close="child-dialog" aria-label="Schließen">×</button></div><div class="dialog-body"><input name="id" type="hidden" /><input name="revision" type="hidden" /><div class="form-grid"><label>Vorname<input name="firstName" required maxlength="80" autocomplete="off" /></label><label>Nachname<input name="lastName" required maxlength="80" autocomplete="off" /></label><label>Geburtsdatum<input name="birthDate" type="date" required /></label><label>Geschlecht<select name="gender" required><option value="">Bitte auswählen</option><option value="Female">Weiblich</option><option value="Male">Männlich</option><option value="Diverse">Divers</option><option value="Unspecified">Keine Angabe</option></select></label></div><fieldset><legend>Staatsangehörigkeiten</legend><div class="country-picker" id="child-countries"></div></fieldset><div class="form-section"><h3>Notfallkontakt <span class="muted small">optional</span></h3><div class="form-grid"><label>Name<input name="contactName" maxlength="100" autocomplete="off" /></label><label>Telefonnummer<input name="contactPhone" type="tel" maxlength="40" autocomplete="off" /></label><label class="full">Beziehung zum Kind<input name="contactRelationship" maxlength="80" placeholder="z. B. Mutter, Vater, Bezugsperson" autocomplete="off" /></label></div></div><label class="check" id="duplicate-confirm" hidden><input type="checkbox" name="confirmDuplicate" /> Geprüft: Es handelt sich um ein anderes Kind.</label><div id="child-error" class="notice error" role="alert" hidden></div><section id="history-section" hidden><h3>Anwesenheiten korrigieren</h3><div class="button-row"><input name="historyDay" type="date" aria-label="Anwesenheit nachtragen am" /><button class="button" type="button" data-action="backfill">Nachtragen</button></div><div id="history-list"></div></section><section id="delete-section" class="danger-zone" hidden><h3>Profil entfernen</h3><p class="small muted">Eine Fehlanlage entfernt auch ihre Besuche. Bei einem echten Profil können anonyme Monatssummen erhalten bleiben.</p><div class="button-row"><button type="button" class="button danger" data-action="delete-invalid">Fehlanlage entfernen</button><button type="button" class="button danger" data-action="delete-preserve">Personendaten löschen</button></div></section></div><div class="dialog-footer"><button type="button" class="button" data-close="child-dialog">Abbrechen</button><button type="submit" class="button primary" name="save" value="only">Speichern</button><button type="submit" class="button primary" name="save" value="attend" id="save-and-attend">Speichern & heute erfassen</button></div></form></dialog>
<dialog id="confirm-dialog" class="dialog compact"><div class="dialog-body"><h2 id="confirm-title">Aktion bestätigen</h2><p id="confirm-text"></p><div class="button-row"><button class="button" data-close="confirm-dialog">Abbrechen</button><button class="button danger" id="confirm-action">Endgültig entfernen</button></div></div></dialog>
