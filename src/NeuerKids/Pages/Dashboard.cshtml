@page
@{ ViewData["Title"] = "Dashboard"; ViewData["Page"] = "dashboard"; }
<div class="page-heading"><div><div class="eyebrow">GEMEINSAM MEHR VERSTEHEN</div><h1>Unsere Besuche im Blick.</h1><p>Zeiträume vergleichen. Entwicklungen entdecken.</p></div><button id="export-button" class="button">↓ Excel exportieren</button></div>
<section class="dashboard-toolbar"><div class="segmented" aria-label="Zeitraum"><button data-period="today">Heute</button><button data-period="week" class="active">Diese Woche</button><button data-period="month">Dieser Monat</button><button data-period="year">Dieses Jahr</button></div><button class="button filter-button" id="open-filters">☷ Filter & Zeitraum <span id="filter-count" class="count-pill" hidden></span></button></section>
<div id="active-filters" class="active-filters" aria-label="Aktive Filter"></div>
<div id="report-error" class="notice error" role="alert" hidden></div><div id="report-notice" class="notice" hidden></div>
<div id="dashboard-results" aria-live="polite"><div class="stats-grid"><article class="stat-card featured"><span>Besuche</span><strong id="metric-visits">—</strong><div id="delta-visits" class="stat-delta"></div></article><article class="stat-card"><span id="children-metric-label">Unterschiedliche Kinder</span><strong id="metric-children">—</strong><div id="delta-children" class="stat-delta"></div></article><article class="stat-card"><span>Ø Besuche je Kalendertag</span><strong id="metric-average">—</strong><div id="delta-average" class="stat-delta"></div></article></div>
<div id="empty-report" class="empty-state" hidden>Für diese Auswahl gibt es keine Besuche. Passe den Zeitraum oder die Filter an.</div>
<section class="panel timeline-panel"><div class="section-heading"><div><h2>So entwickelt sich der Besuch</h2><span class="muted small" id="chart-period"></span></div><label class="inline-label">Ansicht<select id="chart-grouping"><option value="day">Tage</option><option value="week">Wochen</option><option value="month">Monate</option></select></label></div><div class="chart-legend"><span class="legend-current">Auswahl</span><span class="legend-previous">Vergleich</span></div><div id="timeline-chart" class="timeline-chart"></div></section>
<div class="charts-grid"><section class="panel"><div class="section-heading"><h2>Besuche nach Wochentag</h2><span class="small muted">Zum Filtern anklicken</span></div><div id="weekday-chart" class="weekday-chart"></div></section><section class="panel"><div class="section-heading"><h2>Altersgruppen</h2><span class="small muted">Am Besuchstag</span></div><div id="age-chart" class="horizontal-chart"></div></section><section class="panel"><div class="section-heading"><h2>Geschlecht</h2></div><div id="gender-chart" class="horizontal-chart"></div></section><section class="panel"><div class="section-heading"><h2>Staatsangehörigkeiten</h2></div><div id="nationality-chart" class="horizontal-chart"></div><p class="small muted">Mehrfachstaatsangehörigkeiten können in mehreren Kategorien erscheinen.</p></section><section class="panel" id="site-chart-panel" hidden><div class="section-heading"><h2>Unsere Standorte</h2></div><div id="site-chart" class="horizontal-chart"></div></section></div>
<section class="panel" id="archive-panel" hidden><h2>Anonyme Archivbesuche</h2><p class="muted">Ungefilterte Monatssummen nach Profillöschungen. Nicht auf einzelne Tage oder Personengruppen aufteilbar.</p><div id="archive-table"></div></section></div>
<dialog id="filter-dialog" class="dialog filter-dialog"><form id="filter-form"><div class="dialog-heading"><div><span class="eyebrow">DEINE AUSWERTUNG</span><h2>Filter & Zeitraum</h2></div><button type="button" class="icon-button" data-close="filter-dialog" aria-label="Schließen">×</button></div><div class="dialog-body"><div class="form-grid"><label>Von<input type="date" name="start" required /></label><label>Bis<input type="date" name="end" required /></label></div><fieldset><legend>Standorte</legend><div id="filter-sites" class="checkbox-list"></div></fieldset><div class="form-grid"><label>Alter von<input type="number" name="minAge" min="0" max="100" placeholder="Alle" /></label><label>Alter bis<input type="number" name="maxAge" min="0" max="100" placeholder="Alle" /></label></div><fieldset><legend>Geschlecht</legend><div class="checkbox-list"><label class="check"><input type="checkbox" name="gender" value="Female" /> Weiblich</label><label class="check"><input type="checkbox" name="gender" value="Male" /> Männlich</label><label class="check"><input type="checkbox" name="gender" value="Diverse" /> Divers</label><label class="check"><input type="checkbox" name="gender" value="Unspecified" /> Keine Angabe</label></div></fieldset><fieldset><legend>Staatsangehörigkeiten</legend><div id="filter-countries" class="country-picker"></div><small>Keine Auswahl berücksichtigt alle Staatsangehörigkeiten.</small></fieldset><label>Wochentag<select name="weekday"><option value="">Alle Wochentage</option><option value="1">Montag</option><option value="2">Dienstag</option><option value="3">Mittwoch</option><option value="4">Donnerstag</option><option value="5">Freitag</option><option value="6">Samstag</option><option value="0">Sonntag</option></select></label><div class="form-section"><label>Vergleich<select name="comparison"><option value="previous">Vorheriger Zeitraum</option><option value="custom">Eigener Vergleichszeitraum</option><option value="none">Ohne Vergleich</option></select></label><div class="form-grid" id="comparison-dates" hidden><label>Vergleich von<input name="compareStart" type="date" /></label><label>Vergleich bis<input name="compareEnd" type="date" /></label></div></div></div><div class="dialog-footer"><button class="button" type="button" id="reset-filters">Zurücksetzen</button><button class="button primary">Auswertung anzeigen →</button></div></form></dialog>
